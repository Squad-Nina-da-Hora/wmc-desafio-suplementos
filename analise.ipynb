        "outliers = df[(df['ganho_massa'] < (q1 - 1.5 * iqr)) | (df['ganho_massa'] > (q3 + 1.5 * iqr))]\n",
        "print(f\"Total de outliers encontrados: {len(outliers)}\")\n",
        "outliers"
